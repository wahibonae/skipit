{
  "name": "skipit-extension",
  "version": "1.0.0",
  "description": "Skip unwanted content on streaming platforms",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --mode development",
    "build:prod": "tsc && vite build",
    "zip": "rm -f skipit-extension.zip && cd dist && zip -r ../skipit-extension.zip .",
    "package": "npm run build:prod && npm run zip",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
